# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real credentials.

# Admin login lives in src/config/admin.ts, not here.

# ---------- GitHub Pages (static build) ----------
# A project site is served from https://<user>.github.io/<repo>/, so pages
# need the repo name as a base path. Leave it empty for a custom domain or a
# <user>.github.io repo.
NEXT_PUBLIC_BASE_PATH=/beekeeping

# Full public URL of the deployed site
NEXT_PUBLIC_SITE_URL=https://ashish-001.github.io/beekeeping
