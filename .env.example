# Copy this file to .env.local for local overrides. .env.local is git-ignored.
#
# Admin login lives in src/config/admin.ts, not here.

# ---------- GitHub Pages build ----------
# These are set by .github/workflows/deploy.yml. Don't set them in .env.local,
# or the local site will look for pages and images under the wrong path.
#
# GITHUB_PAGES=true                       # switch to the static-export build
# NEXT_PUBLIC_BASE_PATH=/beekeeping       # repo name; the site lives at <user>.github.io/<repo>/
# NEXT_PUBLIC_WEB3FORMS_KEY=              # from the repo secret WEB3FORMS_ACCESS_KEY (https://web3forms.com)
